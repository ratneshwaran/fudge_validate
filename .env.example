# Copy to .env and fill in. All three are read from .env automatically.

# OpenAI — LLM intent labelling (scripts/llm_label_star.py, scripts/llm_label_tv.py)
OPENAI_API_KEY=

# Hugging Face read token — gated Thousand Voices of Trauma download (setup_data.sh).
# Accept the terms at https://huggingface.co/datasets/yenopoya/thousand-voices-trauma first.
HF_TOKEN=

# OpenRouter — LLM DAG generation (scripts/generate_llm_dags.py) and the
# LLM judge (scripts/llm_judge.py)
OPENROUTER_API_KEY=
